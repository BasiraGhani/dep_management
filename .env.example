# Settings for `docker compose up` (read from .env next to docker-compose.yml).
# Copy to .env and fill in real values. Never commit .env.
# (backend/.env.example and frontend/.env.example are for running without Docker.)

# PostgreSQL. The password is required.
POSTGRES_USER=dept
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dept

# Required. Signs JWTs; at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-of-32-plus-chars

# Access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# First admin account, created on start if both are set (password: 8+ characters).
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=change-me-too

# true = also create demo data with one login per role (password: demo-password).
SEED_DEMO=false

# Port on this machine for the app (http://localhost when 80).
HTTP_PORT=80
