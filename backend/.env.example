# Copy to .env and fill in real values. Never commit .env.
# Read by app/config.py. Real environment variables override values in this file.

# SQLAlchemy URL. SQLite in development; for PostgreSQL only this value changes, e.g.
# DATABASE_URL=postgresql+psycopg://dept:change-me@localhost:5432/dept
DATABASE_URL=sqlite:///./dept.db

# Required. Signs JWTs; at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Access token lifetime in minutes (>= 1).
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allowed frontend origins, comma-separated.
CORS_ORIGINS=http://localhost:5173

# First admin account, created by `python -m app.cli seed-admin` (T2.4).
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=change-me
